local function thaiLen(word)
    local ok, parts = pcall(ThaiUI.splitThai, word)
    if ok and type(parts) == "table" then return #parts end
    return utf8.len(word) or #word
end
local LOOKUP_GAP, lastLookup = 0.9, 0
local function lookup(prefix, page)
    for _ = 1, 3 do
        local wait = LOOKUP_GAP - (os.clock() - lastLookup)
        if wait > 0 then task.wait(wait) end
        lastLookup = os.clock()
        local ok, res = pcall(function()
            return Remotes.DictLookup:InvokeServer(prefix, page or 1)
        end)
        if ok and type(res) == "table" and res.ok then return res end
        task.wait(0.6)
    end
end
local function addWords(entry, res)
    for _, w in ipairs(res and res.words or {}) do
        if not entry.seen[w] then
            entry.seen[w] = true
            entry.list[#entry.list + 1] = w
        end
    end
end
local function getEntry(prefix)
    local entry = State.cache[prefix]
    if entry then return entry end
    local first = lookup(prefix, 1)
    if not first then return nil end
    entry = { list = {}, seen = {}, pages = first.pages or 1, order = {}, fetched = { [1] = true } }
    addWords(entry, first)
    local n = entry.pages
    for _, f in ipairs({ 0.5, 0.25, 0.75, 0.125, 0.375, 0.625, 0.875 }) do
        local p = math.clamp(math.floor(n * f + 0.5), 1, n)
        if not entry.fetched[p] then
            entry.order[#entry.order + 1] = p
            entry.fetched[p] = "queued"
        end
    end
    State.cache[prefix] = entry
    return entry
end
local function fetchMore(entry, prefix)
    local p = table.remove(entry.order, 1)
    if not p then return false end
    local res = lookup(prefix, p)
    if res then addWords(entry, res) end
    entry.fetched[p] = true
    return true
end
local function buildPool(entry, prefix, minLen, exclude)
    local pool = {}
    local pLen = thaiLen(prefix)
    for _, w in ipairs(entry.list) do
        if not State.used[w] and not (exclude and exclude[w]) and w:sub(1, #prefix) == prefix then
            local n = thaiLen(w)
            if n > pLen and (not minLen or n >= minLen) then
                pool[#pool + 1] = { w = w, n = n }
            end
        end
    end
    return pool
end
local function pickWord(prefix, minLen, exclude, maxFetch)
    local entry = getEntry(prefix)
    if not entry then return nil end
    maxFetch = maxFetch or 3
    local function satisfied(pool)
        if #pool == 0 then return false end
        if Config.PreferLong or Config.PickMode == "ยาวสุด" then
            for _, e in ipairs(pool) do
                if e.n >= 6 then return true end
            end
            return false
        end
        return true
    end
    local pool = buildPool(entry, prefix, minLen, exclude)
    local fetched = 0
    while not satisfied(pool) and fetched < maxFetch and fetchMore(entry, prefix) do
        fetched += 1
        pool = buildPool(entry, prefix, minLen, exclude)
    end
    if #pool == 0 then return nil end
    if Config.PreferLong then
        local long = {}
        for _, e in ipairs(pool) do
            if e.n >= 6 then long[#long + 1] = e end
        end
        if #long > 0 then pool = long end
    end
    if Config.PickMode == "สั้นสุด" then
        table.sort(pool, function(a, b) return a.n < b.n end)
        return pool[1].w
    elseif Config.PickMode == "ยาวสุด" then
        table.sort(pool, function(a, b) return a.n > b.n end)
        return pool[1].w
    end
    return pool[math.random(1, #pool)].w
end
