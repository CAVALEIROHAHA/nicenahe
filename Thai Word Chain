-- Adapted from the supplied Airflow C (hover), w (stroke flash), and ag (ripple).
local AirflowDetail = {}
local motion = setmetatable({}, { __mode = "k" })
function AirflowDetail.tween(item, properties, duration)
    if not item.Parent or not isRunning() then return end
    if motion[item] then motion[item]:Cancel() end
    local tween = TweenService:Create(item, TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties)
    motion[item] = tween
    tween:Play()
end
function AirflowDetail.outline(item, isButton)
    -- Each stroke has its own inset plane, so its full thickness stays inside the clipping boundary.
    local planes = {}
    local function insetStroke(name, inset, thickness, color)
        local plane = make("Frame", {
            Name = name .. "Plane", Position = UDim2.fromOffset(inset, inset), Size = UDim2.new(1, -2 * inset, 1, -2 * inset),
            BackgroundTransparency = 1, BorderSizePixel = 0, Active = false, ZIndex = item.ZIndex + 1,
        }, item)
        planes[#planes + 1] = { plane = plane, inset = inset }
        local edge = stroke(plane, color)
        edge.Name, edge.Thickness = name, thickness
        return edge
    end
    local border = insetStroke("AirflowBorder", 1, 1, C.line)
    border.Name = "AirflowBorder"
    border.Transparency = isButton and 0.55 or 0.8
    local glow = insetStroke("AirflowGlow", 3, isButton and 4 or 3, C.blue)
    glow.Name = "AirflowGlow"
    glow.Thickness = isButton and 4 or 3
    glow.Transparency = 1
    local halo = insetStroke("AirflowHalo", 4, isButton and 7 or 5, C.blue)
    halo.Name = "AirflowHalo"
    halo.Thickness = isButton and 7 or 5
    halo.Transparency = 1
    local rounded = item:FindFirstChildOfClass("UICorner")
    local function syncCorners()
        local radius = rounded and rounded.CornerRadius.Offset or 9
        for _, layer in ipairs(planes) do corner(layer.plane, math.max(2, radius - layer.inset)) end
    end
    syncCorners()
    if rounded then trackConn(rounded:GetPropertyChangedSignal("CornerRadius"):Connect(syncCorners)) end
    local hovered, pressed = false, false
    local function paint()
        local selected = item:GetAttribute("Selected") == true
        AirflowDetail.tween(border, {
            Color = (hovered or selected) and C.blue or C.line,
            Transparency = pressed and 0 or hovered and 0.08 or selected and 0.2 or isButton and 0.55 or 0.8,
        }, hovered and 0.12 or 0.26)
        AirflowDetail.tween(glow, { Transparency = pressed and 0.75 or hovered and 0.88 or 1 }, 0.2)
        AirflowDetail.tween(halo, { Transparency = hovered and 0.97 or 1 }, 0.24)
        if isButton then
            local color = selected and C.blue or hovered and Color3.fromRGB(31, 47, 65) or C.raised
            if pressed then color = color:Lerp(C.white, 0.1) end
            AirflowDetail.tween(item, { BackgroundColor3 = color }, 0.16)
        end
    end
    trackConn(item.MouseEnter:Connect(function() hovered = true; paint() end))
    trackConn(item.MouseLeave:Connect(function() hovered, pressed = false, false; paint() end))
