local function showHint(prefix, minLen)
    local words, ex = {}, {}
    local hintTurn = State.turnId
    for i = 1, 6 do
        if not isRunning() or State.turnId ~= hintTurn then return end
        local w = pickWord(prefix, minLen, ex, i == 1 and 3 or 0)
        if not w then break end
        ex[w] = true
        words[#words + 1] = w
    end
    if isRunning() and State.turnId == hintTurn and UI.setHint then UI.setHint(prefix, minLen, words) end
end
local function wordBox()
