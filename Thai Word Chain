function AirflowDetail.ripple(item, event)
    if not item.Parent or not isRunning() then return end
    local factor = item.AbsoluteSize.X / math.max(1, item.Size.X.Offset)
    local point = Vector2.new(item.Size.X.Offset / 2, item.Size.Y.Offset / 2)
    if event and (event.UserInputType == Enum.UserInputType.MouseButton1 or event.UserInputType == Enum.UserInputType.Touch) then
        local cursor = Vector2.new(event.Position.X, event.Position.Y)
        point = (cursor - item.AbsolutePosition) / math.max(0.01, factor)
    end
    local size = math.max(item.Size.X.Offset, item.Size.Y.Offset) * 2.2
    local wave = make("Frame", {
        Name = "AirflowRipple", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(point.X, point.Y),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = item:GetAttribute("Selected") and C.white or C.blue,
        BackgroundTransparency = 0.82, BorderSizePixel = 0, ZIndex = item.ZIndex + 1, Active = false,
    }, item)
    corner(wave, 1000)
    AirflowDetail.tween(wave, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, 0.55)
    task.delay(0.56, function() wave:Destroy() end)
end
