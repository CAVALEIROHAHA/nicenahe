local function splitChars(s)
    local out = {}
    for _, cp in utf8.codes(s) do out[#out + 1] = utf8.char(cp) end
    return out
end
local function typeOut(word, prefix, duration)
    local chars = splitChars(word:sub(#prefix + 1))
    if #chars == 0 then return end
    local box = wordBox()
    local step = duration / #chars
    local typed = prefix
    local typingTurn = State.turnId
    for _, ch in ipairs(chars) do
        if not isRunning() or not Config.AutoAnswer or State.turnId ~= typingTurn or not State.myTurn then return end
        typed ..= ch
        if box and box.Parent then
            box.Text = typed
        else
            pcall(function() Remotes.Typing:FireServer(typed) end)
        end
        task.wait(step * (0.6 + math.random() * 0.8))
    end
end
local function onMyTurn(turnId, data)
    local prefix, minLen = data.prefix or "", data.minLen
    showHint(prefix, minLen)
    if not Config.AutoAnswer then return end
    local timeLimit = (data.time or 15) - 0.8
    local started = os.clock()
    local tried = {}
    local hold = (data.timeStop or 0) + (data.frozen or 0)
    local spread = math.max(0, Config.DelayMax - Config.DelayMin)
    local budget = math.max(hold + 0.15, Config.DelayMin + math.random() * spread)
    budget = math.min(budget, timeLimit - 0.3)
    for attempt = 1, (Config.Retry and 4 or 1) do
        if not isRunning() or State.turnId ~= turnId then return end
        local word = pickWord(prefix, minLen, tried)
        if not word then
            notify("2K SCRIPT", "ไม่มีคำที่ต่อจาก \"" .. prefix .. "\" ได้", 4)
            return
        end
        tried[word] = true
        local total = attempt == 1 and budget or 0.35
        local letters = #splitChars(word:sub(#prefix + 1))
        local typing = Config.SimTyping and (letters / math.max(1, Config.TypeSpeed)) or 0
        local think = math.max(hold, total - typing)
        local left = timeLimit - (os.clock() - started) - 0.3
        if think + typing > left then typing = math.max(0.1, left - think) end
        if think > 0 then task.wait(think) end
        if not isRunning() or not Config.AutoAnswer or State.turnId ~= turnId then return end
        if Config.SimTyping and typing > 0 then typeOut(word, prefix, typing) end
        if not isRunning() or not Config.AutoAnswer or State.turnId ~= turnId or os.clock() - started > timeLimit then return end
        Remotes.Submit:FireServer(word)
        local t0 = os.clock()
        while os.clock() - t0 < 1.5 do
            if State.turnId ~= turnId or State.wrongTurn == turnId then break end
            task.wait(0.05)
        end
        if State.wrongTurn ~= turnId then return end
        State.wrongTurn = -1
    end
end
trackConn(Remotes.Match.OnClientEvent:Connect(function(d)
    if type(d) ~= "table" then return end
    local t = d.t
    if t == "start" then
        State.inMatch, State.seatedAt = true, nil
        State.used = {}
    elseif t == "end" or t == "left" then
        State.turnId += 1
        State.inMatch, State.myTurn = false, false
        State.used, State.seatedAt = {}, nil
        if UI.clearHint then UI.clearHint() end
    elseif t == "turn" then
        State.inMatch, State.seatedAt = true, nil
        State.turnId += 1
        State.prefix, State.minLen = d.prefix or "", d.minLen
        State.myTurn = d.userId == LocalPlayer.UserId
        if State.myTurn then
            task.spawn(onMyTurn, State.turnId, d)
        elseif UI.clearHint then
            UI.clearHint()
        end
    elseif t == "correct" and d.word then
        State.used[d.word] = true
        if d.userId == LocalPlayer.UserId then State.answered += 1 end
    elseif t == "wrong" and d.word then
        State.used[d.word] = true
        if d.userId == LocalPlayer.UserId then State.wrongTurn = State.turnId end
    end
end))
local function claimQuests()
    local ok, res = pcall(function() return Remotes.Quest:InvokeServer("state") end)
    if not (ok and type(res) == "table" and res.state) then return 0 end
    local claimed = 0
    for _, q in ipairs(res.state.list or {}) do
        if not q.claimed and (q.prog or 0) >= (q.goal or math.huge) then
            local ok2, r = pcall(function() return Remotes.Quest:InvokeServer("claim", q.id) end)
            if ok2 and r then
                claimed += 1
                notify("เควสสำเร็จ", "รับรางวัล: " .. tostring(q.text), 4)
            end
        end
    end
    return claimed
end
