local function make(class, props, parent)
    local item = Instance.new(class)
    for k, v in pairs(props) do item[k] = v end
    if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
        local bold = props.Font == Enum.Font.GothamBold
        item:SetAttribute("UIFontBold", bold)
        if Config.UIFont == "Mali" and MaliFamily then
            item.FontFace = Font.new(MaliFamily, bold and Enum.FontWeight.Bold or Enum.FontWeight.Regular)
        end
    end
    item.Parent = parent
    return item
end
local function corner(item, radius)
    local rounded = item:FindFirstChildOfClass("UICorner") or make("UICorner", {}, item)
    rounded.CornerRadius = UDim.new(0, radius or 12)
end
