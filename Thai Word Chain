local function decodeFont(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #alphabet do lookup[string.byte(alphabet, i)] = i - 1 end
    local output = table.create(math.ceil(#data / 4))
    for i = 1, #data, 4 do
        local a, b, c, d = string.byte(data, i, i + 3)
        local value = lookup[a] * 262144 + lookup[b] * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)
        local one, two, three = math.floor(value / 65536), math.floor(value / 256) % 256, value % 256
        output[#output + 1] = c == 61 and string.char(one) or d == 61 and string.char(one, two) or string.char(one, two, three)
    end
    return table.concat(output)
end
