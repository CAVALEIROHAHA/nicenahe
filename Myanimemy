function app:SetLanguage(language)
    self.Language=language=="th" and "th" or "en"
    for _,binding in ipairs(localeBindings) do if binding.Instance.Parent then binding.Instance.Text=tr(binding.English) end end
    for _,t in ipairs(tabs) do t.Name=tr(t.EnglishName);t._label.Text=t.Name;t.TitleLabel.Text=t.Name end
    for _,entry in ipairs(controls) do
        local title=entry.Control._frame:FindFirstChild("ControlTitle",true)
        local desc=entry.Control._frame:FindFirstChild("ControlDescription",true)
        if title then title.Text=tr(entry.English) end
        if desc then desc.Text=tr(entry.Description or "") end
    end
