connect(Input.InputBegan,function(input,processed)
    if captureKey then
        if input.UserInputType~=Enum.UserInputType.Keyboard then return end
        if input.KeyCode==Enum.KeyCode.Escape then captureKey=nil;uiNotice="";return end
        local name=input.KeyCode==Enum.KeyCode.Backspace and "None" or input.KeyCode.Name
        if not validKey(name) then return end
        for key,value in pairs(app.Keys) do if key~=captureKey and value==name and name~="None" then say("Key already used.");return end end
        app.Keys[captureKey]=name;captureKey=nil;uiNotice="";return
    end
    if processed or Input:GetFocusedTextBox() then return end
    local name=input.KeyCode.Name
    if name==app.Keys.Stop then app:SetEnabled(false)
    elseif name==app.Keys.OneClick then app:SetEnabled(not app.Master)
    elseif name==app.Keys.Menu then toggleMenu()
    elseif name==app.Keys.AFK then app:SetAFKView(not app.ShowAFK) end
end)
