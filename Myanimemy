    end
    return shareRequest("POST",d.ShareURL.."/share",{place_id=tostring(game.PlaceId),game_id=tostring(game.GameId),script=d.ScriptName or self.Gui.Name,name=name,config={placeId=game.PlaceId,flags=flags}})
