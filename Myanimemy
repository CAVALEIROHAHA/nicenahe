            local root = rootPart()
            local humanoid = root and root.Parent:FindFirstChildOfClass("Humanoid")
            if not root or not humanoid or travel or app.Training or Input:GetFocusedTextBox()
                or humanoid.Sit or humanoid.FloorMaterial == Enum.Material.Air then
                app.AntiAFKStatus = "Waiting to jump"
                app.NextAntiAFK = os.clock() + 10
                return
            end
            local jumped = false
            stateConnection = humanoid.StateChanged:Connect(function(_, state)
                if state == Enum.HumanoidStateType.Jumping then jumped = true end
            end)
