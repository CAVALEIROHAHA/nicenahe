function app:IsFeatureEnabled(key)
    return (self.Master and not FarmPlus.Explicit[key]) or self.Features[key] == true
end

function app:SyncRunning()
    local wasEnabled = self.Enabled
    local enabled = self.Master or self.RequestedSale == true or #self.Requests > 0
    for _, selected in pairs(self.Features) do enabled = enabled or selected end
    if self.ActiveSince then
        self.ActiveSeconds += os.clock() - self.ActiveSince
        self.ActiveSince = nil
    end
    self.Generation += 1
    self.Enabled = enabled == true
    if self.Enabled then
        self.ActiveSince = os.clock()
        if not wasEnabled then self.GoalStartActive = self.ActiveSeconds; self.StopReason = nil end
    end
    self.Status = self.Enabled and (self.Master and "One Click running" or "Selected features running") or "Stopped"
    if refresh then refresh() end
end

function app:SetFeature(key, enabled)
    assert(self.Features[key] ~= nil, "Unknown feature: " .. tostring(key))
    if self.Destroyed then return end
    if self.Master and not FarmPlus.Explicit[key] then
        for name in pairs(self.Features) do if not FarmPlus.Explicit[name] then self.Features[name] = true end end
        self.Master = false
    end
    self.Features[key] = enabled == true
    self:SyncRunning()
    self.NextSale, self.NextEquip, self.NextTeamCheck = 0, 0, 0
end

local function data()
    local snapshot = GameState.GetData2()
    if type(snapshot) == "table" and type(snapshot.MineGame) == "table" then return snapshot end
end

local function alive(generation)
    return not app.Destroyed and app.Enabled and app.Generation == generation
end

local function pause(seconds, generation)
    local deadline = os.clock() + seconds
    repeat
        if not alive(generation) then return false end
        task.wait(0.05)
    until os.clock() >= deadline
    return alive(generation)
end

local function rootPart()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health > 0 then return character:FindFirstChild("HumanoidRootPart") end
end

local function plot()
    local world = workspace:FindFirstChild("MineWorld")
    local plots = world and world:FindFirstChild("Plots")
    if plots then
        for _, candidate in ipairs(plots:GetChildren()) do
            if candidate:GetAttribute("OwnerUserId") == player.UserId then return candidate end
        end
    end
end

local function restorePosition()
    if not travel then return end
    local trip = travel
    travel = nil
    if rootPart() == trip.Root then trip.Root.CFrame = trip.Origin end
end

local function atLocation(target, generation, callback)
    local root = rootPart()
    if not root or not target or not alive(generation) then return false end
    travel = {Root = root, Origin = root.CFrame}
    local success, result = xpcall(function()
        root.CFrame = target:GetPivot() + Vector3.new(0, 3, 3)
        if not pause(0.4, generation) or rootPart() ~= root then return false end
        return callback()
    end, debug.traceback)
    restorePosition()
    if not success then error(result) end
    return result
end

local function waitFor(predicate, generation, timeout)
    local deadline = os.clock() + (timeout or 4)
    repeat
        if not alive(generation) then return false end
        local current = data()
        if current and predicate(current) then return true end
        if not pause(0.1, generation) then return false end
    until os.clock() >= deadline
    return false
end

local function quantity(value)
    if value == true then return 1 end
    return tonumber(value) or 0
end

local function total(inventory)
    local count = 0
    for _, amount in pairs(inventory or {}) do count += quantity(amount) end
    return count
end

local function zoneOpen(mine, key)
    return key == "Z1" or (mine.UnlockedZones or {})[key] == true
