local function newAction(kind, key, cost, event, arguments, read, before, label)
    return {Kind = kind, Key = key, Cost = cost, Event = event, Args = arguments,
        Read = read, Before = before, Label = label}
end

local function chooseCheapest(actions)
    table.sort(actions, function(left, right)
        if left.Cost ~= right.Cost then return left.Cost < right.Cost end
        return left.Key < right.Key
    end)
    return actions[1]
end

local function available(action)
    if app.SpendingPaused and action.Cost > 0 then return false end
    local feature = action.Feature or ({zone = "Zones", skill = "Research", pickaxe = "Pickaxes"})[action.Kind]
    if action.Kind == "miner" then feature = action.Args[2] end
    if action.Kind == "core" then feature = action.Key == "tap" and "Tap" or "Slots" end
    if feature and not action.Forced and not app:IsFeatureEnabled(feature) then return false end
    local failure = app.Failures[action.Key]
    return not failure or os.clock() >= failure.RetryAt
end

