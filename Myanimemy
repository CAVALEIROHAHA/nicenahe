task.spawn(function()
    while not app.Destroyed do
        if app.Enabled then
            local generation = app.Generation
            app.Pending = true
            local ok, message = xpcall(function()
                if app:CheckFarmGoals(data()) then return end
                if not data() or not rootPart() or not plot() then app.Status = "Waiting for character / plot / data"; return end
                if player:GetAttribute("TitanGeodeActive") ~= nil then app.Status = "Paused during Titan Geode"; return end
                local request = app.Requests[1]
                if request then
                    if request == "sale" then sell(generation, true)
                    elseif request == "chest" then sell(generation, true, true)
                    elseif request == "equip" then
                        GameState.SendEvent("MineEquipBest")
                        app.LastAction = "Equip best team requested"
                        pause(0.6, generation)
                    elseif request == "rewards" then
                        GameState.SendEvent(EventRewards.Events.Open)
                        GameState.SendEvent(DailyQuests.Events.Open)
                        if pause(0.5, generation) then
                            for _ = 1, 24 do
                                if not alive(generation) then break end
                                local reward = nextReward(data(), true)
                                if not reward then break end
                                perform(reward, generation)
                            end
                        end
                    end
                    if app.Requests[1] == request then table.remove(app.Requests, 1) end
                    if alive(generation) then app:SyncRunning() end
                    return
                end
                if (app:IsFeatureEnabled("ClaimIndex") or app:IsFeatureEnabled("ClaimDaily") or app:IsFeatureEnabled("ClaimEvents"))
                    and os.clock() >= app.NextRewards then
                    app.NextRewards = os.clock() + app.FarmOptions.RewardsInterval
                    if app:IsFeatureEnabled("ClaimDaily") then GameState.SendEvent(DailyQuests.Events.Open) end
                    if app:IsFeatureEnabled("ClaimEvents") then GameState.SendEvent(EventRewards.Events.Open) end
                    if not pause(0.4, generation) then return end
                    for _ = 1, 4 do
                        if not alive(generation) then break end
                        local reward = nextReward(data())
                        if not reward then break end
                        perform(reward, generation)
                    end
                end
                if app.RequestedSale then
                    sell(generation, true)
                    app.RequestedSale = false
                    app:SyncRunning()
                    return
                end
                local saleSnapshot = data()
                local saleDue = os.clock() >= app.NextSale
                local sellReady = saleSnapshot and app:IsFeatureEnabled("SellOres") and (saleDue or os.clock() >= app.NextBagSale)
                    and FarmPlus.ShouldSell(saleSnapshot, app.FarmOptions, saleDue)
                if (app:IsFeatureEnabled("CollectChest") and saleDue) or sellReady then
                    sell(generation, false, not sellReady)
                    if alive(generation) then
                        app.NextSale = os.clock() + app.SellInterval
                        if sellReady then app.NextBagSale = os.clock() + math.min(5, app.SellInterval) end
                    end
                end
                if app:CheckFarmGoals(data()) then return end
                if not alive(generation) then return end
                if app:IsFeatureEnabled("TrainTeam") and not app.SpendingPaused and os.clock() >= app.NextTeamCheck then
                    app.NextTeamCheck = os.clock() + app.FarmOptions.TeamInterval
                    local investment = findTeamInvestment(data())
                    if investment then
                        app.TeamStatus = string.format("%s: needs %s for +%.0f%%", investment.Target.CharName,
                            moneyText(investment.Cost), (investment.Gain - 1) * 100)
                        if investment.Cost <= FarmPlus.Spendable(data(), app.FarmOptions) * app.TrainBudget then trainTeam(investment, generation) end
                    else app.TeamStatus = "Current team retained / no stronger investment found" end
                    if not alive(generation) then return end
                end
                if app:IsFeatureEnabled("EquipBest") and os.clock() >= app.NextEquip then
                    GameState.SendEvent("MineEquipBest")
                    app.NextEquip = os.clock() + app.FarmOptions.EquipInterval
                    if not pause(0.6, generation) then return end
                end
                local snapshot = data()
                if not snapshot then return end
                local extra = app:NextExtraAction(snapshot)
                if extra then perform(extra,generation) end
                if not alive(generation) or app:CheckFarmGoals(data()) then return end
                snapshot = data()
                if not snapshot then return end
                local action, reason = plan(snapshot)
                if action then
                    if app.SpendingPaused and action.Cost > 0 then app.Status = "Spending paused"
                    elseif FarmPlus.CanSpend(snapshot, action.Cost, app.FarmOptions) then
                        perform(action, generation)
                    else
                        app.Status = string.format("Saving: %s (%s / %s)", action.Label, moneyText(FarmPlus.Spendable(snapshot, app.FarmOptions)), moneyText(action.Cost))
                    end
                else app.Status = reason end
            end, debug.traceback)
            app.Pending = false
            if not ok then
                restorePosition()
                app.LastError = tostring(message):match("^[^\n]+") or tostring(message)
                app.Status = "Retrying after error"
                warn("[Mine OneClick] " .. tostring(message))
                pause(3, generation)
            end
        end
        task.wait(0.3)
    end
end)

