refresh=function()
    if app.Destroyed then return end
    applyLayout()
    applying=true
    for _,entry in ipairs(controls) do
        if entry.Kind=="Toggle" then entry.Control:Set(entry.Get()==true,true)
        elseif entry.Kind=="Choice" then entry.Value.Text=entry.Format(entry.Get()) end
    end
    applying=false
    local elapsed=math.floor(app.ActiveSeconds+(app.ActiveSince and os.clock()-app.ActiveSince or 0))
    timerLabel.Text=string.format("%02d:%02d:%02d",math.floor(elapsed/3600),math.floor(elapsed/60)%60,elapsed%60)
    liveBadge.Text=app.Enabled and "LIVE" or "IDLE"
    overlayStart.Text=tr(app.Enabled and "Stop" or "Start")
    footer.Text=uiNotice~="" and tr(uiNotice) or (app.LastError~="" and app.LastError or displayStatus(app.Status))
    local remaining=math.max(0,math.ceil(app.NextAntiAFK-os.clock()))
    afkAnti.Text=tr("Keep game active").." · "..(app.AntiAFK and string.format("%02d:%02d",math.floor(remaining/60),remaining%60) or tr("Stopped"))
    local snapshot=data()
    if not snapshot then return end
    local mine=snapshot.MineGame
    local zone="Z"..tostring(mine.CurrentZone)
    local definition=Config.Zones[zone]
    local done,needed=Config.GetZoneResearchProgress(mine.Skills or {},zone)
    cashValue.Text,afkCash.Text=moneyText(snapshot.Money),moneyText(snapshot.Money)
    revenueValue.Text,afkRevenue.Text=moneyText(app.Revenue),moneyText(app.Revenue)
    zoneLabel.Text=zone.." · "..tostring(definition and definition.DisplayName or "").." · "..tostring(done).."/"..tostring(needed)
    afkZone.Text=zone.." · "..tostring(definition and definition.DisplayName or "")
    barFill.Size=UDim2.fromScale(needed>0 and math.clamp(done/needed,0,1) or 1,1)
