function Plus.Validate(saved, zones)
    assert(saved == nil or type(saved) == "table", "Invalid farm settings")
    local result = table.clone(Plus.Defaults)
    for key, value in pairs(saved or {}) do
        assert(Plus.Defaults[key] ~= nil, "Unknown farm setting: " .. tostring(key))
        if key == "CashReserve" or key == "StopCash" then
            assert(type(value) == "number" and value == value and value >= 0 and value < math.huge, "Invalid cash value")
        elseif key == "TargetZone" then
            assert(value == "Auto" or table.find(zones, value), "Invalid target zone")
        else
            assert(allowed[key] and table.find(allowed[key], value), "Invalid farm setting: " .. key)
        end
        result[key] = value
    end
    return result
end

function Plus.Spendable(snapshot, options)
    local money = math.max(0, tonumber(snapshot.Money) or 0)
    return math.max(0, math.min(money - options.CashReserve, money * options.PurchasePercent / 100))
end

function Plus.CanSpend(snapshot, cost, options)
    return cost <= 0 or cost <= Plus.Spendable(snapshot, options)
end

function Plus.Cap(stat, gameCap, options)
    local selected = options[stat .. "Cap"] or 0
    return selected > 0 and math.min(gameCap, selected) or gameCap
end

function Plus.GoalReason(snapshot, elapsed, options)
    if options.StopCash > 0 and (tonumber(snapshot.Money) or 0) >= options.StopCash then return "Cash target reached" end
    if options.StopMinutes > 0 and elapsed >= options.StopMinutes * 60 then return "Farm timer completed" end
end

function Plus.ShouldSell(snapshot, options, due)
    local count = 0
    for _, amount in pairs(snapshot.MineGame.Ores or {}) do count += tonumber(amount) or 0 end
    if options.SellMode == "Threshold" then return count >= options.BagThreshold end
    if options.SellMode == "Either" then return due or count >= options.BagThreshold end
    return due
end

local function fingerprint(counts)
    local result = {}
    for key, value in pairs(counts or {}) do table.insert(result, tostring(key) .. "=" .. tostring(value)) end
    table.sort(result)
    return table.concat(result, ";")
end

local farmFamilies = {OreLuck=true,Unearth=true,Prospect=true,Strength=true,Haste=true,Regrowth=true,Crit=true,Sell=true,ChestCap=true,Yield=true,OreOutput=true,TapFury=true}
local luckFamilies = {CharLuck=true,MutLuck=true,EnchantLuck=true,SummonLuck=true,MythicLuck=true,ScaledLuck=true}
local function strength(definition)
    local multiplier = tonumber(definition.Mult)
    if multiplier and multiplier > 0 then return multiplier < 1 and 1 / multiplier or multiplier end
    return tonumber(definition.Add) or 0
end

function Plus.MakeAction(feature, key, event, args, read, before, label, location, cooldown)
    return {Kind="extra", Key="plus:"..key, Cost=0, Event=event, Args=args, Read=read, Before=before,
        Label=label, Feature=feature, Location=location, Cooldown=cooldown or 5}
end

function Plus.MailAction(snapshot, support)
    if not support.Mail then return nil, "Mail module unavailable" end
    for _, message in ipairs((snapshot.Mailbox or {}).Messages or {}) do
        if message.Id and support.Mail.HasUnclaimed(message) then
            for index, reward in ipairs(message.Rewards or {}) do
                if not support.Mail.IsClaimed(message, reward) then
                    local id, rewardIndex = message.Id, index
                    return Plus.MakeAction("ClaimMail", "mail:"..tostring(id)..":"..index, "ClaimMailboxReward", {id,index}, function(current)
                        for _, entry in ipairs((current.Mailbox or {}).Messages or {}) do
                            if entry.Id == id then
                                local item = (entry.Rewards or {})[rewardIndex]
                                return entry.Claimed == true or (item and support.Mail.IsClaimed(entry,item)) == true
                            end
                        end
                        return true
                    end, false, "Mailbox / "..tostring(message.Title or id), nil, 1)
                end
            end
        end
    end
    return nil, "No mailbox rewards ready"
end

function Plus.PotionAction(snapshot, options, support)
    local catalog, config = support.Potions, support.Config
    if not catalog or type(config.GetBoost) ~= "function" then return nil, "Potion API unavailable" end
    local mine, best = snapshot.MineGame, {}
    for _, definition in ipairs(catalog.Potions or {}) do
        local family = definition.Family
        local selected = options.PotionSet == "All timed" or (options.PotionSet == "Farm" and farmFamilies[family])
            or (options.PotionSet == "Luck" and luckFamilies[family])
        if selected and definition.Kind == "Timed" and (tonumber((mine.Potions or {})[definition.ItemName]) or 0) > options.PotionReserve
            and not config.GetBoost(mine,family) then
            local previous = best[family]
            if not previous or strength(definition) > strength(previous)
                or (strength(definition) == strength(previous) and definition.ItemName < previous.ItemName) then best[family] = definition end
        end
    end
    local families = {}
    for family in pairs(best) do table.insert(families,family) end
    table.sort(families)
    local chosen = best[families[1]]
    if not chosen then return nil, "Selected potion buffs active or no spare potions" end
    local name = chosen.ItemName
    return Plus.MakeAction("AutoPotions", "potion:"..name, "MineUsePotion", {name,1}, function(current)
        return fingerprint((current.MineGame.Boosts or {})[chosen.Family])
    end, fingerprint((mine.Boosts or {})[chosen.Family]), "Potion / "..name, nil, 1)
end

function Plus.SummonAction(snapshot, options, support)
    local catalog, config = support.Summons, support.Config
    if not catalog or type(config.GetSummonScrollCount) ~= "function" then return nil, "Summon API unavailable" end
    if not catalog.Unlocked(snapshot.MineGame) then return nil, "Summoning not unlocked" end
    if config.GetSummonScrollCount(snapshot.MineGame) <= options.ScrollReserve then return nil, "Keeping scroll reserve" end
    local function read(current)
        return tostring(config.GetSummonScrollCount(current.MineGame))..":"..fingerprint(current.MineGame.Characters)
    end
    return Plus.MakeAction("AutoSummon", "summon", "MineSummon", {}, read, read(snapshot), "Summon character", "SummonShrine",
        math.max(5,(tonumber(catalog.RevealSeconds) or 3.4)+1))
end

function Plus.DiceAction(snapshot, options, support)
    local catalog, config = support.Enchants, support.Config
    if not catalog or type(config.GetEnchantDiceCount) ~= "function" then return nil, "Enchant API unavailable" end
    local mine = snapshot.MineGame
    if not catalog.Unlocked(mine) then return nil, "Enchants not unlocked" end
    if options.DiceStopRank > 0 then
        for name, count in pairs(mine.EnchantItems or {}) do
            if (tonumber(count) or 0) > 0 and catalog.Rank(name) >= options.DiceStopRank then return nil, "Target enchant rank owned" end
        end
        for _, name in pairs(mine.Enchants or {}) do
            if catalog.Rank(name) >= options.DiceStopRank then return nil, "Target enchant rank equipped" end
        end
    end
    if config.GetEnchantDiceCount(mine) <= options.DiceReserve then return nil, "Keeping dice reserve" end
    local function read(current)
        return tostring(config.GetEnchantDiceCount(current.MineGame))..":"..fingerprint(current.MineGame.EnchantItems)
    end
    return Plus.MakeAction("AutoRollDice", "dice", "MineRollEnchant", {1}, read, read(snapshot), "Roll one regular enchant die", "EnchantAltar",
        math.max(5,(tonumber(catalog.RevealSeconds) or 3.4)+1))
end

function Plus.EnchantAction(snapshot, support)
    local catalog, config = support.Enchants, support.Config
    if not catalog or type(config.GetHolderEnchantName) ~= "function" or type(config.GetEnchantItemCount) ~= "function" then return nil, "Enchant API unavailable" end
    local mine = snapshot.MineGame
    if not catalog.Unlocked(mine) then return nil, "Enchants not unlocked" end
    local names, holders = {}, {}
    for name in pairs(mine.EnchantItems or {}) do
        if config.GetEnchantItemCount(mine,name) > 0 then table.insert(names,name) end
    end
    table.sort(names,function(a,b)
        local ar,br = catalog.Rank(a),catalog.Rank(b)
        return ar > br or (ar == br and a < b)
    end)
    for key, holder in pairs(mine.Holders or {}) do
        if key:sub(1,1) == "M" and holder.CharName then table.insert(holders,key) end
    end
    table.sort(holders,function(a,b)
        local ar,br = catalog.Rank(config.GetHolderEnchantName(mine,a)),catalog.Rank(config.GetHolderEnchantName(mine,b))
        return ar < br or (ar == br and a < b)
    end)
    local slot, name = holders[1], names[1]
    if not slot or not name or catalog.Rank(name) <= catalog.Rank(config.GetHolderEnchantName(mine,slot)) then return nil, "No rarer spare enchant" end
    return Plus.MakeAction("AutoEnchants", "enchant:"..slot, "MineEquipEnchant", {slot,name}, function(current)
        return config.GetHolderEnchantName(current.MineGame,slot)
    end, config.GetHolderEnchantName(mine,slot), "Equip rarer enchant / "..slot.." / "..name, nil, 1)
end

return Plus

end)()

