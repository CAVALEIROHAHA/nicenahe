local function create(class, properties, parent)
    local instance = Instance.new(class)
    for key, value in pairs(properties) do instance[key] = value end
    instance.Parent = parent
    return instance
end

local backgroundAsset
local backgroundError = ""
local function loadBackground()
    assert(type(writefile) == "function", "Background requires writefile")
    local register = getcustomasset or getsynasset
    assert(type(register) == "function", "Background requires getcustomasset")
    local encoded = ""
    local decoded
    if crypt and type(crypt.base64decode) == "function" then
        decoded = crypt.base64decode(encoded)
    else
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local lookup, bytes = {}, {}
        for index = 1, #alphabet do lookup[alphabet:sub(index, index)] = index - 1 end
        for index = 1, #encoded, 4 do
            local first = lookup[encoded:sub(index, index)] or 0
            local second = lookup[encoded:sub(index + 1, index + 1)] or 0
            local third = lookup[encoded:sub(index + 2, index + 2)]
            local fourth = lookup[encoded:sub(index + 3, index + 3)]
            table.insert(bytes, string.char(first * 4 + math.floor(second / 16)))
            if third then table.insert(bytes, string.char((second % 16) * 16 + math.floor(third / 4))) end
            if fourth then table.insert(bytes, string.char((third % 4) * 64 + fourth)) end
            if index % 32768 == 1 then task.wait() end
        end
        decoded = table.concat(bytes)
    end
    local path = "MyAnimeMine-Nebula-AFK-v2.png"
    writefile(path, decoded)
    return register(path)
end

