    return {Version=3,FarmOptions=table.clone(app.FarmOptions),Language=app.Language,Keys=table.clone(app.Keys),UIScale=app.UIScale,SellInterval=app.SellInterval,
        AntiAFKInterval=app.AntiAFKInterval,TrainBudget=app.TrainBudget,TrainGain=app.TrainGain,
        Master=app.Master,Features=table.clone(app.Features),AntiAFK=app.AntiAFK,
        BackgroundEnabled=app.BackgroundEnabled,SpendingPaused=app.SpendingPaused}
end
