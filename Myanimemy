function app:CheckFarmGoals(snapshot)
    if not self.Enabled or not snapshot then return false end
    local elapsed=self.ActiveSeconds+(self.ActiveSince and os.clock()-self.ActiveSince or 0)-self.GoalStartActive
    local reason=FarmPlus.GoalReason(snapshot,elapsed,self.FarmOptions)
    if not reason then return false end
    self:SetEnabled(false)
    self.StopReason,self.Status=reason,reason
    return true
end

function app:NextExtraAction(snapshot)
    local order={"ClaimMail","AutoEnchants","AutoPotions","AutoSummon","AutoRollDice"}
    for offset=1,#order do
        local index=((self.ExtraCursor or 0)+offset-1)%#order+1
        local feature=order[index]
        if self:IsFeatureEnabled(feature) and os.clock()>=(self.ExtraDue[feature] or 0) then
            self.ExtraDue[feature]=os.clock()+2
            local action,reason
            if feature=="ClaimMail" then action,reason=FarmPlus.MailAction(snapshot,FarmPlus.Support)
            elseif feature=="AutoEnchants" then action,reason=FarmPlus.EnchantAction(snapshot,FarmPlus.Support)
            elseif feature=="AutoPotions" then action,reason=FarmPlus.PotionAction(snapshot,self.FarmOptions,FarmPlus.Support)
            elseif feature=="AutoSummon" then action,reason=FarmPlus.SummonAction(snapshot,self.FarmOptions,FarmPlus.Support)
            elseif feature=="AutoRollDice" then action,reason=FarmPlus.DiceAction(snapshot,self.FarmOptions,FarmPlus.Support) end
            self.ExtraStatus[feature]=action and action.Label or reason
            if action and available(action) then
                self.ExtraCursor=index
                self.ExtraDue[feature]=os.clock()+action.Cooldown
                return action
            end
        end
    end
end

local function eventEntry(id)
