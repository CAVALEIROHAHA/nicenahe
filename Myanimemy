            task.wait(0.15)
            if pressed and keyboard then
                pcall(function() keyboard:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
                pressed = false
            end
            local deadline = os.clock() + 2
            repeat
                if not current() or rootPart() ~= root then return end
                if jumped or root.AssemblyLinearVelocity.Y > 2 then
                    app.LastAntiAFK = os.clock()
                    app.AntiAFKJumps += 1
                    app.AntiAFKStatus = inputOK and "Jump + input OK" or "Jump OK / input blocked"
                    app.AntiAFKError = inputOK and "" or ("Jump works; idle-reset input failed: " .. tostring(inputError))
                    app.NextAntiAFK = os.clock() + app.AntiAFKInterval
                    return
                end
                task.wait(0.05)
            until os.clock() >= deadline
            error("Jump was not observed; retrying in 10 seconds")
        end, debug.traceback)
        if stateConnection then stateConnection:Disconnect() end
        if pressed and keyboard then pcall(function() keyboard:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end) end
        if not ok and current() then
