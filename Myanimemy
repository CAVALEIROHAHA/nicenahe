local function validKey(value)
    if value=="None" then return true end
    local ok,key=pcall(function() return Enum.KeyCode[value] end)
    return ok and key~=nil and key~=Enum.KeyCode.Unknown
end
local function applySettings(saved)
    assert(type(saved)=="table","Invalid settings")
    local keys,used={},{}
    for name,fallback in pairs({Menu="RightShift",OneClick="F6",Stop="End",AFK="F8"}) do
        local key=saved.Keys and saved.Keys[name] or fallback
        assert(type(key)=="string" and validKey(key),"Invalid key")
        assert(key=="None" or not used[key],"Duplicate key")
        used[key],keys[name]=true,key
    end
    local scale,sale,jump=tonumber(saved.UIScale),tonumber(saved.SellInterval),tonumber(saved.AntiAFKInterval)
    local budget,gain=tonumber(saved.TrainBudget),tonumber(saved.TrainGain)
    assert(scale and scale==scale and scale>=0.75 and scale<=1.3,"Invalid scale")
    assert(table.find({20,40,60,120},sale) and table.find({300,600,900},jump),"Invalid timer")
    assert(table.find({0.1,0.2,0.3},budget) and table.find({1.1,1.25,1.5},gain),"Invalid training settings")
    assert(not app.Training,"Wait for training")
    local farmOptions = FarmPlus.Validate(saved.FarmOptions, Config.ZoneKeys)
    local restoredFeatures={}
    for key in pairs(app.Features) do
        local value=type(saved.Features)=="table" and saved.Features[key] or false
        assert(value==nil or type(value)=="boolean","Invalid feature")
        restoredFeatures[key]=value==true
    end
    assert(saved.Master==nil or type(saved.Master)=="boolean","Invalid One Click setting")
    app.FarmOptions = farmOptions
    app.Keys,app.UIScale,app.SellInterval=keys,scale,sale
    app.AntiAFKInterval,app.TrainBudget,app.TrainGain=jump,budget,gain
    app.NextAntiAFK=os.clock()+jump
    app:SetLanguage(saved.Language)
    if saved.Version==2 or saved.Version==3 then
        app:SetAntiAFK(saved.AntiAFK~=false)
        app:SetBackground(saved.BackgroundEnabled~=false)
        app.SpendingPaused=saved.SpendingPaused==true
        app.Master=saved.Master==true
        app.Features=restoredFeatures
        app:SyncRunning()
        app.NextSale,app.NextEquip,app.NextTeamCheck,app.NextRewards=0,0,0,0
    end
end
