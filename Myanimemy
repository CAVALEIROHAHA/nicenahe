end

local function rewardAction(feature, key, event, arguments, read, before, label, forced)
    local action = newAction("reward", key, 0, event, arguments, read, before, label)
    action.Feature, action.Forced = feature, forced == true
    local failure = app.Failures[key]
    if (forced or app:IsFeatureEnabled(feature)) and (not failure or os.clock() >= failure.RetryAt) then return action end
end

local function nextReward(snapshot, forced)
    local mine = snapshot.MineGame
    if (forced or app:IsFeatureEnabled("ClaimIndex")) and IndexRewards.Enabled ~= false then
        for _, category in ipairs(IndexRewards.Keys()) do
            local definition = IndexRewards.Category(category)
            if definition and (not definition.Zone or (mine.UnlockedZones or {})[category] == true) then
                local state = IndexRewards.State(mine, category)
                for _, tier in ipairs(state.Track or {}) do
                    if tier.Reached then
                        for index in ipairs(tier.Rewards or {}) do
                            if not (tier.ClaimedRewards or {})[index] then
                                local tierKey, rewardIndex, categoryKey = tier.Key, index, category
                                local action = rewardAction("ClaimIndex", "index:" .. categoryKey .. ":" .. tierKey .. ":" .. index,
                                    IndexRewards.Events.Claim, {categoryKey, tierKey, index}, function(current)
                                        for _, updated in ipairs(IndexRewards.State(current.MineGame, categoryKey).Track or {}) do
                                            if updated.Key == tierKey then return (updated.ClaimedRewards or {})[rewardIndex] == true end
                                        end
                                        return false
                                    end, false, "Index / " .. categoryKey, forced)
                                if action then return action end
                            end
                        end
                    end
                end
            end
        end
    end
    if forced or app:IsFeatureEnabled("ClaimDaily") then
        if DailyReward.Unlocked(mine) and DailyReward.Ready(mine.DailySpin) then
            local action = rewardAction("ClaimDaily", "daily:spin", DailyReward.Events.Spin, {},
                function(current) return tonumber((current.MineGame.DailySpin or {}).Spins) or 0 end,
                tonumber((mine.DailySpin or {}).Spins) or 0, "Daily Reward", forced)
            if action then return action end
        end
        local daily = mine.DailyQuests or {}
        if DailyQuests.IsToday(daily, workspace:GetServerTimeNow()) then
            local slots = table.clone(DailyQuests.Slots)
            table.insert(slots, DailyQuests.GrandSlot)
            for _, slot in ipairs(slots) do
                local quest = slot == DailyQuests.GrandSlot and daily.Grand or DailyQuests.Quest(daily, slot)
                local ready
                if slot == DailyQuests.GrandSlot then ready = DailyQuests.AllDone(daily)
                else ready = quest and DailyQuests.IsComplete(quest) end
                if ready and (not quest or quest.Claimed ~= true) then
                    local claimSlot = slot
                    local action = rewardAction("ClaimDaily", "daily:" .. tostring(slot), DailyQuests.Events.Claim, {slot},
                        function(current)
                            local state = current.MineGame.DailyQuests or {}
                            local updated = claimSlot == DailyQuests.GrandSlot and state.Grand or DailyQuests.Quest(state, claimSlot)
                            return updated and updated.Claimed == true or false
                        end, false, "Daily Quest / " .. tostring(slot), forced)
                    if action then return action end
                end
            end
        end
    end
    if (forced or app:IsFeatureEnabled("ClaimEvents")) and (app.EventPayload or {}).Enabled ~= false
        and os.clock() - app.EventPayloadAt < 60 then
        for _, event in pairs((app.EventPayload or {}).Events or {}) do
            local function fromEvent(entry, tiers)
                if not entry or not entry.Id then return nil end
                for tier, requirement in ipairs(entry.Thresholds or {}) do
                    if (tonumber(entry.Points) or 0) >= requirement and not (entry.Claimed or {})[tier] then
                        for index in ipairs((tiers[tier] or {}).Rewards or {}) do
                            if bit32.band(tonumber((entry.Got or {})[tier]) or 0, 2 ^ (index - 1)) == 0 then
                                local id, tierIndex, rewardIndex = entry.Id, tier, index
                                local action = rewardAction("ClaimEvents", "event:" .. id .. ":" .. tier .. ":" .. index,
                                    EventRewards.Events.Claim, {id, tier, index}, function()
                                        local updated = eventEntry(id)
                                        return updated and ((updated.Claimed or {})[tierIndex] == true
                                            or bit32.band(tonumber((updated.Got or {})[tierIndex]) or 0, 2 ^ (rewardIndex - 1)) ~= 0) or false
                                    end, false, "Event / " .. tostring(event.Key), forced)
                                if action then return action end
                            end
                        end
                    end
                end
            end
            local definition = EventRewards.Catalog[event.Key]
            if definition then
                local action = fromEvent(event, EventRewards.Tiers(event.Days, definition))
                    or fromEvent(event.Personal, EventRewards.PersonalTiers())
                if action then return action end
            end
        end
    end
end

function app:QueueAction(kind)
    if self.Destroyed then return end
    assert(kind == "equip" or kind == "rewards" or kind == "sale" or kind == "chest", "Unknown action")
    for _, queued in ipairs(self.Requests) do if queued == kind then return end end
    table.insert(self.Requests, kind)
    if not self.Enabled then self:SyncRunning() end
end

local function holderStack(holder)
    return Config.CharStackKey(holder.CharName, Config.GetHolderLevel(holder), Config.GetHolderVariant(holder),
        Config.GetHolderSpeedLevel(holder), Config.GetHolderMineSpeedLevel(holder), Config.GetHolderSerial(holder))
end

local function findTeamInvestment(snapshot)
    local mine = snapshot.MineGame
    local slot, original, weakestScore
    for key, holder in pairs(mine.Holders or {}) do
        local item = holder.CharName and Items.GetItemData(holder.CharName)
        if key:sub(1, 1) == "M" and item and item.MineRole ~= "Hauler" and not Config.GetHolderScaled(holder) then
            local score = Config.GetHolderDamage(holder, item) * Config.GetHolderMineSpeed(holder)
            if not weakestScore or score < weakestScore or (score == weakestScore and key < slot) then
                slot, original, weakestScore = key, holder, score
            end
        end
    end
    if not slot then return nil end
    local oldItem = Items.GetItemData(original.CharName)
    local oldDamage = Config.GetHolderDamage(original, oldItem)
    local best
    for stack, count in pairs(mine.Characters or {}) do
        if quantity(count) > 0 then
            local name, level, variant, speed, mining, serial = Config.ParseCharStack(stack)
            local item = name and Items.GetItemData(name)
            if item and item.MineRole ~= "Hauler" and not serial then
                local candidate = {CharName = name, CharLevel = level, CharVariant = variant,
                    CharSpeedLevel = math.max(speed, Config.GetHolderSpeedLevel(original)),
                    CharMineSpeedLevel = math.max(mining, Config.GetHolderMineSpeedLevel(original)), Pickaxe = original.Pickaxe}
                local cost = 0
                for current = speed, candidate.CharSpeedLevel - 1 do cost += Config.GetCharacterSpeedUpgradeCost(current, item) end
                for current = mining, candidate.CharMineSpeedLevel - 1 do cost += Config.GetCharacterMineSpeedUpgradeCost(current, item) end
                local cap = FarmPlus.Cap("Damage", Config.GetCharLevelCap(mine, slot, candidate, item, Items.GetItemData), app.FarmOptions)
                if FarmPlus.Cap("Speed", candidate.CharSpeedLevel, app.FarmOptions) < candidate.CharSpeedLevel
                    or FarmPlus.Cap("MineSpeed", candidate.CharMineSpeedLevel, app.FarmOptions) < candidate.CharMineSpeedLevel then cap = level - 1 end
                for target = level, cap do
                    candidate.CharLevel = target
                    local damage = Config.GetHolderDamage(candidate, item)
                    local score = damage * Config.GetHolderMineSpeed(candidate)
                    if damage >= oldDamage * app.TrainGain and score >= weakestScore * app.TrainGain then
                        if not best or cost < best.Cost or (cost == best.Cost and score > best.Score) then
                            best = {Slot = slot, Stack = stack, Original = table.clone(original), Cost = cost,
                                Target = table.clone(candidate), Score = score, Gain = score / math.max(weakestScore, 1)}
                        end
                        break
                    end
                    cost += Config.GetCharacterUpgradeCost(target, item)
                    if best and cost > best.Cost then break end
                end
            end
        end
    end
    return best
end

function app:InspectTeam()
    local snapshot = data()
    if not snapshot then return {Status = "Waiting for data"} end
    local investment = findTeamInvestment(snapshot)
    return {Status = self.TeamStatus, Candidate = investment and investment.Target.CharName,
        Slot = investment and investment.Slot, Cost = investment and investment.Cost,
        TargetLevel = investment and investment.Target.CharLevel, Gain = investment and investment.Gain,
        Budget = FarmPlus.Spendable(snapshot, self.FarmOptions) * self.TrainBudget}
end

local function trainTeam(investment, generation)
    if type(fireproximityprompt) ~= "function" then app.TeamStatus = "Training needs prompt support"; return end
    local ownPlot = plot()
    local holders = ownPlot and ownPlot:FindFirstChild("Holders")
    local pad = holders and holders:FindFirstChild(investment.Slot)
    local prompt = pad and pad:FindFirstChild("HolderPrompt", true)
    if not prompt then return end
    local snapshot = data()
    if not snapshot or not alive(generation) or app.SpendingPaused or investment.Cost > FarmPlus.Spendable(snapshot, app.FarmOptions) * app.TrainBudget then return end
    if holderStack(snapshot.MineGame.Holders[investment.Slot]) ~= holderStack(investment.Original) then return end
    local root = rootPart()
    if not root then return end
    local origin, oldEquipped = root.CFrame, snapshot.MineGame.Equipped or ""
    local hotbarSlot
    for _, key in ipairs(Inventory.VisibleSlotKeys()) do
        if not (snapshot.MineGame.Hotbar or {})[key] then hotbarSlot = key; break end
    end
    if not hotbarSlot then app.TeamStatus = "Training waiting for a free hotbar slot"; return end
    local originalKey = holderStack(investment.Original)
    local function holder()
        local current = data()
        return current and (current.MineGame.Holders or {})[investment.Slot]
    end
    local function awaitState(predicate, recovering)
        local deadline = os.clock() + 5
        repeat
            if not recovering and not alive(generation) then error("Training stopped") end
            if predicate() then return end
            task.wait(0.1)
        until os.clock() >= deadline
        error("Team change was not confirmed")
    end
    local function place(stack, recovering)
        if not recovering and not alive(generation) then error("Training stopped") end
        GameState.SendEvent("MineAssignHotbar", hotbarSlot, stack)
        awaitState(function() return (data().MineGame.Hotbar or {})[hotbarSlot] == stack end, recovering)
        GameState.SendEvent("MineEquipSlot", hotbarSlot)
        awaitState(function() return data().MineGame.Equipped == hotbarSlot end, recovering)
        fireproximityprompt(prompt)
        awaitState(function() local current = holder(); return current and current.CharName and holderStack(current) == stack end, recovering)
    end
    app.Training = true
    travel = {Root = root, Origin = origin}
    local success, message = xpcall(function()
        root.CFrame = pad:GetPivot() + Vector3.new(0, 3, 3)
        if not pause(0.4, generation) then error("Training stopped") end
        GameState.SendEvent("MineEquipSlot", "")
        awaitState(function() return data().MineGame.Equipped == "" end)
        fireproximityprompt(prompt)
        awaitState(function() local current = holder(); return not current or not current.CharName end)
        place(investment.Stack)
        if investment.Original.Pickaxe then
            GameState.SendEvent("MineEquipPickaxe", investment.Slot, investment.Original.Pickaxe)
            awaitState(function() return holder().Pickaxe == investment.Original.Pickaxe end)
        end
        for _, spec in ipairs({{"Speed", "CharSpeedLevel", Config.GetHolderSpeedLevel},
            {"MineSpeed", "CharMineSpeedLevel", Config.GetHolderMineSpeedLevel}, {"Damage", "CharLevel", Config.GetHolderLevel}}) do
            local target = investment.Target[spec[2]]
            while spec[3](holder()) < target do
                if not alive(generation) then error("Training stopped") end
                if app.SpendingPaused then error("Training paused") end
                local before = spec[3](holder())
                local priceFunction = ({Damage=Config.GetCharacterUpgradeCost,Speed=Config.GetCharacterSpeedUpgradeCost,MineSpeed=Config.GetCharacterMineSpeedUpgradeCost})[spec[1]]
                local price = priceFunction(before, Items.GetItemData(investment.Target.CharName))
                if not FarmPlus.CanSpend(data(), price, app.FarmOptions) then error("Training paused at spending limit") end
                GameState.SendEvent("MineUpgradeCharacter", investment.Slot, spec[1])
                awaitState(function() local current = holder(); return current and spec[3](current) > before end)
                app.Confirmed += 1
                app.PlusStats.Spent += price
                app.Status = "Training " .. investment.Target.CharName .. " / " .. spec[1]
            end
        end
        local current = holder()
        local item = current and Items.GetItemData(current.CharName)
        local originalDamage = Config.GetHolderDamage(investment.Original, Items.GetItemData(investment.Original.CharName))
        assert(item and Config.GetHolderDamage(current, item) >= originalDamage * app.TrainGain
            and Config.GetHolderDamage(current, item) * Config.GetHolderMineSpeed(current) >= originalDamage * Config.GetHolderMineSpeed(investment.Original) * app.TrainGain,
            "Candidate did not reach planned damage")
        app.TeamStatus = string.format("Promoted %s / %.0f%% stronger", current.CharName, (investment.Gain - 1) * 100)
    end, debug.traceback)
    if not success then
        local recovered, recoveryError = pcall(function()
            if rootPart() ~= root then error("Waiting for the original character to return") end
            root.CFrame = pad:GetPivot() + Vector3.new(0, 3, 3)
            local current = holder()
            if current and current.CharName and holderStack(current) == originalKey then return end
            GameState.SendEvent("MineEquipSlot", "")
            awaitState(function() return data().MineGame.Equipped == "" end, true)
            if current and current.CharName then
                fireproximityprompt(prompt)
                awaitState(function() local updated = holder(); return not updated or not updated.CharName end, true)
            end
            place(originalKey, true)
            if investment.Original.Pickaxe then
                GameState.SendEvent("MineEquipPickaxe", investment.Slot, investment.Original.Pickaxe)
                awaitState(function() return holder().Pickaxe == investment.Original.Pickaxe end, true)
            end
        end)
        app.TeamStatus = recovered and "Training cancelled / original miner restored" or "Restore miner manually: " .. originalKey
        app.LastError = recovered and (alive(generation) and tostring(message):match("^[^\n]+") or "") or tostring(recoveryError)
        if not recovered then app:SetEnabled(false) end
    end
    pcall(function()
        GameState.SendEvent("MineAssignHotbar", hotbarSlot, "")
        GameState.SendEvent("MineEquipSlot", oldEquipped)
    end)
    restorePosition()
    app.Training = false
    app.NextTeamCheck = os.clock() + app.FarmOptions.TeamInterval
    app.NextEquip = os.clock() + app.FarmOptions.EquipInterval
end

local function plan(snapshot)
    local mine = snapshot.MineGame
    local money = FarmPlus.Spendable(snapshot, app.FarmOptions)
    local highest = "Z1"
    local nextZone
    local zoneLimit = app.FarmOptions.TargetZone == "Auto" and #Config.ZoneKeys or table.find(Config.ZoneKeys, app.FarmOptions.TargetZone)
    for index, zone in ipairs(Config.ZoneKeys) do
        if index > zoneLimit then break end
        if zoneOpen(mine, zone) then highest = zone else nextZone = zone; break end
    end
    if app:IsFeatureEnabled("Zones") and "Z" .. tostring(mine.CurrentZone) ~= highest then
        return newAction("zone", "select:" .. highest, 0, "MineSelectZone", {highest},
            function(current) return current.MineGame.CurrentZone end, mine.CurrentZone, "Travel to " .. highest)
    end

    if not app:IsFeatureEnabled("Zones") then highest = "Z" .. tostring(mine.CurrentZone); nextZone = nil end
    local researchDone = Config.IsZoneResearchComplete(mine.Skills or {}, highest)
    if app:IsFeatureEnabled("Zones") and nextZone and researchDone then
        local cost = tonumber(Config.Zones[nextZone].UnlockCost)
        assert(cost, "Missing zone price: " .. nextZone)
        return newAction("zone", "unlock:" .. nextZone, cost, "MineSelectZone", {nextZone},
            function(current) return (current.MineGame.UnlockedZones or {})[nextZone] end,
            (mine.UnlockedZones or {})[nextZone], "Unlock " .. nextZone)
    end

    local teamPower = Config.GetTeamPower(mine, Items.GetItemData)
    local skills, blocked, upgrades, damage, picks = {}, {}, {}, {}, {}
    local zoneSkills = (mine.Skills or {})[highest] or {}
    for _, node in ipairs(Config.GetSkillNodes(highest)) do
        if not Config.IsSkillNodeMaxed(zoneSkills, node) and Config.IsSkillNodeOpen(zoneSkills, node) then
            local family, nodeId = node.Family, node.Id
            local level = tonumber(zoneSkills[family]) or 0
            local cost = tonumber(Config.GetSkillCost(highest, level, family))
            local requirement = tonumber(Config.GetSkillPowerReq(highest, family, level + 1)) or 0
            if cost then
                local action = newAction("skill", "skill:" .. highest .. ":" .. nodeId, cost,
                    "MineBuySkill", {highest, family, nodeId}, function(current)
                        return ((current.MineGame.Skills or {})[highest] or {})[family] or 0
                    end, level, highest .. " / " .. node.Name)
                if available(action) then
                    table.insert(requirement <= teamPower and skills or blocked, action)
                end
            end
        end
    end

    local minerCount = 0
    for holderKey, holder in pairs(mine.Holders or {}) do
        local item = holder.CharName and Items.GetItemData(holder.CharName)
        if item then
            local isMiner = item.MineRole ~= "Hauler"
            if isMiner then minerCount += 1 end
            local specs = {
                {"Damage", Config.GetHolderLevel, Config.GetCharLevelCap(mine, holderKey, holder, item, Items.GetItemData), Config.GetCharacterUpgradeCost},
                {"Speed", Config.GetHolderSpeedLevel, Config.CharSpeedMaxLevel, Config.GetCharacterSpeedUpgradeCost},
                {"MineSpeed", Config.GetHolderMineSpeedLevel, Config.CharMineSpeedMaxLevel, Config.GetCharacterMineSpeedUpgradeCost},
            }
            for _, spec in ipairs(specs) do
                local stat, getter, cap, price = table.unpack(spec)
                local level = getter(holder)
                if cap then cap = FarmPlus.Cap(stat, cap, app.FarmOptions) end
                if cap and level < cap and (isMiner or stat == "Speed") then
                    local cost = tonumber(price(level, item))
                    if cost then
                        local key = holderKey
                        local action = newAction("miner", "miner:" .. key .. ":" .. stat, cost,
                            "MineUpgradeCharacter", {key, stat}, function(current)
                                local currentHolder = (current.MineGame.Holders or {})[key]
                                return currentHolder and getter(currentHolder)
                            end, level, key .. " / " .. stat .. " Lv " .. tostring(level + 1))
                        if available(action) then
                            table.insert(upgrades, action)
                            if stat == "Damage" and isMiner then table.insert(damage, action) end
                        end
                    end
                end
            end
        end
    end

    local tapLevel = tonumber(mine.TapLevel) or 1
    if type(fireclickdetector) == "function" and tapLevel < (Config.TapMaxLevel or tapLevel) then
        local cost = tonumber(Config.GetTapUpgradeCost(tapLevel))
        if cost then
            local action = newAction("core", "tap", cost, "MineUpgradeTap", {},
                function(current) return current.MineGame.TapLevel or 1 end, tapLevel, "Tap Lv " .. tostring(tapLevel + 1))
            if available(action) then table.insert(upgrades, action) end
        end
    end
    local slots = tonumber(mine.MinerSlots) or 5
    if slots < (Config.MaxMinerSlots or slots) then
        local cost = tonumber((Config.MinerSlotCosts or {})[slots + 1])
        if cost then
            local action = newAction("core", "slots", cost, "MineBuyMinerSlot", {},
                function(current) return current.MineGame.MinerSlots or 5 end, slots, "Miner slot " .. tostring(slots + 1))
            if available(action) then table.insert(upgrades, action) end
        end
    end

    for index, pickaxe in ipairs(Config.Pickaxes) do
        local cost, power = tonumber(pickaxe.Cost), tonumber(pickaxe.Multiplier)
        if not pickaxe.RobuxOnly and cost and cost > 0 and power and zoneOpen(mine, pickaxe.ZoneReq) then
            local betterCount = 0
            for _, owned in ipairs(Config.Pickaxes) do
                if (tonumber(owned.Multiplier) or 0) >= power then
                    betterCount += quantity((mine.Pickaxes or {})[owned.Name])
                end
            end
            local remaining = Stock.GetRemaining(snapshot, pickaxe.Name)
            if betterCount < minerCount and (remaining == nil or remaining > 0) then
                local name = pickaxe.Name
                local action = newAction("pickaxe", "pickaxe:" .. name, cost, "MineBuyPickaxe", {index},
                    function(current) return quantity((current.MineGame.Pickaxes or {})[name]) end,
                    quantity((mine.Pickaxes or {})[name]), name)
                action.Power = power
                if available(action) then table.insert(picks, action) end
            end
        end
    end
    table.sort(picks, function(left, right)
        if left.Power ~= right.Power then return left.Power > right.Power end
        return left.Cost < right.Cost
    end)

    local goal = chooseCheapest(skills)
    if not goal and #blocked > 0 then
        local powerOptions = table.clone(damage)
        for _, pick in ipairs(picks) do table.insert(powerOptions, pick) end
        goal = chooseCheapest(powerOptions)
        if not goal then return nil, "Power gate: obtain stronger characters or wait for pickaxe restock" end
    end
    if goal and goal.Cost <= money then return goal end
    for _, pick in ipairs(picks) do
        if pick.Cost <= money and (not goal or pick.Cost <= money * 0.2) then return pick end
    end
    local upgrade = chooseCheapest(upgrades)
    if upgrade and (not goal or goal.Cost > money * 4) and upgrade.Cost <= money * 0.1 then return upgrade end
    if goal then return goal end
    if #picks > 0 then return chooseCheapest(picks) end
    if upgrade then return upgrade end
    return nil, researchDone and highest == Config.ZoneKeys[#Config.ZoneKeys] and "Final zone researched - farming continues"
        or (app.FarmOptions.TargetZone ~= "Auto" and highest == app.FarmOptions.TargetZone and "Target zone reached - farming continues")
        or (app.Master and "Waiting for progression requirements" or "Custom mode / selected systems active")
end

function app:Inspect()
    local snapshot = data()
    if not snapshot then return {Status = "Waiting for player data"} end
    local action, reason = plan(snapshot)
    return {Status = self.Status, Enabled = self.Enabled, Pending = self.Pending,
        Master = self.Master, Features = table.clone(self.Features),
        Zone = snapshot.MineGame.CurrentZone, Money = snapshot.Money,
        Action = action and action.Label or reason, Cost = action and action.Cost,
        Confirmed = self.Confirmed, Revenue = self.Revenue, LastError = self.LastError,
        FarmOptions = table.clone(self.FarmOptions), ExtraStatus = table.clone(self.ExtraStatus),
        FarmStats = table.clone(self.PlusStats), StopReason = self.StopReason}
end

local function perform(action, generation)
    if not alive(generation) or not available(action) then return false end
    local function send()
        local current = data()
        if not alive(generation) or not current or not FarmPlus.CanSpend(current, action.Cost, app.FarmOptions) then return false end
        if app.SpendingPaused and action.Cost > 0 then return false end
        if action.Read(current) ~= action.Before then return false end
        app.Status = "Running: " .. action.Label
        app.LastAction = action.Label
        GameState.SendEvent(action.Event, table.unpack(action.Args))
        return waitFor(function(updated) return action.Read(updated) ~= action.Before end, generation)
    end
    local confirmed
    if action.Location then
        local target = workspace:FindFirstChild(action.Location)
        if not target then app.Status = "Waiting for " .. action.Location; return false end
        confirmed = atLocation(target, generation, send)
    elseif action.Kind == "pickaxe" then
        local stand = workspace:FindFirstChild("PickaxesStand")
        local skeleton = stand and stand:FindFirstChild("SkeletonMiner")
        confirmed = atLocation(skeleton or stand, generation, send)
    else
        confirmed = send()
    end
    if confirmed then
        if action.Kind == "reward" then app.RewardsClaimed += 1
        elseif action.Kind == "extra" then
            app.ExtraConfirmed[action.Feature] = (app.ExtraConfirmed[action.Feature] or 0) + 1
            app.ExtraStatus[action.Feature] = "Confirmed: " .. action.Label
            if action.Feature == "ClaimMail" then app.RewardsClaimed += 1 end
            if action.Feature == "AutoSummon" then app.NextEquip = 0 end
        else app.Confirmed += 1 end
        app.PlusStats.Spent += math.max(0,action.Cost)
        app.Failures[action.Key] = nil
        app.LastError = ""
        if action.Kind == "pickaxe" or action.Key == "slots" then app.NextEquip = 0 end
    elseif alive(generation) then
        local previous = app.Failures[action.Key]
        local attempts = previous and previous.Attempts + 1 or 1
        app.Failures[action.Key] = {Attempts = attempts, RetryAt = os.clock() + math.min(60, 3 * 2 ^ math.min(attempts, 5))}
        app.LastError = "No confirmation: " .. action.Label
    end
    return confirmed
end

local function sell(generation, force, collectOnly)
    local snapshot=data()
    if not snapshot or not alive(generation) then return end
    local ownPlot=plot()
    local chest=ownPlot and ownPlot:FindFirstChild("Chest")
    local chestCount=total(snapshot.MineGame.Chest)
    if (force or app:IsFeatureEnabled("CollectChest")) and chestCount>0
        and (force or chestCount>=app.FarmOptions.ChestMinimum) then
        if chest then
            app.Status="Collecting chest"
            local confirmed=atLocation(chest,generation,function()
                local current=data()
                if not current then return false end
                local before=total(current.MineGame.Chest)
                if before<=0 then return false end
                local oresBefore=total(current.MineGame.Ores)
                GameState.SendEvent("MineTakeChest")
                return waitFor(function(updated)
                    return total(updated.MineGame.Chest)<before or total(updated.MineGame.Ores)>oresBefore
                end,generation)
            end)
            if confirmed then
                local current=data()
                app.PlusStats.ChestTrips+=1
                app.PlusStats.Collected+=math.max(0,chestCount-(current and total(current.MineGame.Chest) or chestCount))
            end
        else app.Status="Waiting for chest" end
    end
    if collectOnly or not alive(generation) or (not force and not app:IsFeatureEnabled("SellOres")) then return end
    snapshot=data()
    if not snapshot then return end
    local oreCount=total(snapshot.MineGame.Ores)
    if oreCount<=0 or (not force and oreCount<app.FarmOptions.SaleMinimum) then return end
    local stand=workspace:FindFirstChild("SellStand")
    if not stand then app.Status="Waiting for sell stand"; return end
    app.Status="Selling ore"
    atLocation(stand,generation,function()
        local current=data()
        if not current then return false end
        local keys,amounts={},{}
        for key,amount in pairs(current.MineGame.Ores or {}) do
            if quantity(amount)>0 then table.insert(keys,key); amounts[key]=quantity(amount) end
        end
        if #keys==0 then return false end
        table.sort(keys)
        local before=tonumber(current.Money) or 0
        GameState.SendEvent("MineSellItems",keys)
        local confirmed=waitFor(function(updated)
            for key,amount in pairs(amounts) do
                if quantity((updated.MineGame.Ores or {})[key])>=amount then return false end
            end
            return true
        end,generation)
        if confirmed then
            local updated=data()
            app.Revenue+=math.max(0,(updated and tonumber(updated.Money) or before)-before)
            app.PlusStats.Sales+=1
            for key,amount in pairs(amounts) do
                app.PlusStats.OresSold+=math.max(0,amount-quantity(((updated and updated.MineGame.Ores) or {})[key]))
            end
            app.NextEquip=0
        else app.LastError="Ore sale was not confirmed; retry next cycle" end
        return confirmed
    end)
end

function app:SetEnabled(value)
    if self.Destroyed then return end
    self.RequestedSale = false
    table.clear(self.Requests)
    self.Master = value == true
    for key in pairs(self.Features) do self.Features[key] = false end
    self:SyncRunning()
    restorePosition()
    if self.Enabled then self.NextSale = 0; self.NextEquip = 0 end
    if refresh then refresh() end
end

function app:Destroy()
    if self.Destroyed then return end
    if self.SaveSettings then pcall(function() self:SaveSettings() end) end
    self:SetEnabled(false)
    self.Destroyed = true
    for _, connection in ipairs(self.Connections) do connection:Disconnect() end
    table.clear(self.Connections)
    if self.Window then self.Window:Destroy() elseif screen then screen:Destroy() end
    if _G.MyAnimeMineOneClick == self then _G.MyAnimeMineOneClick = nil end
end

local function create(class, properties, parent)
    local instance = Instance.new(class)
    for key, value in pairs(properties) do instance[key] = value end
    instance.Parent = parent
    return instance
end

